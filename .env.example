NEXTAUTH_URL=http://localhost:3000
# Generate a random secret, e.g. openssl rand -base64 32
NEXTAUTH_SECRET=
# Required only when the database has no users. Never resets existing accounts.
BOOTSTRAP_ADMIN_PASSWORD=
# Required on Vercel: connect a Turso libSQL database (HTTP, no local replica).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional, for local development only:
# DATABASE_PATH=/absolute/path/to/survey.db
